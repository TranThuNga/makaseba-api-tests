		{
			"name": "03b. Đăng ký trùng email khác HOA/thường (REGRESSION bug B7)",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// Đổi dupEmail sang chữ HOA phần trước @ để thử trùng",
							"var e = pm.collectionVariables.get('dupEmail');",
							"var parts = e.split('@');",
							"pm.collectionVariables.set('dupEmailUpper', parts[0].toUpperCase() + '@' + parts[1]);"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// Kỳ vọng ĐÚNG: coi là trùng, từ chối (409/400). Hiện tại tạo được -> FAIL = bug B7.",
							"pm.test('Phải từ chối email trùng khác hoa/thường (409/400)', function () {",
							"  pm.expect(pm.response.code).to.be.oneOf([409, 400, 422]);",
							"});"
						]
					}
				}
			],
