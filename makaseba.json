		"description": "Bộ test API mẫu cho makaseba staging. Mỗi request có sẵn pm.test. Một số test CỐ Ý fail để minh họa 'test canh bug' — khi bug được sửa thì test sẽ pass.\n\nCÁCH DÙNG:\n1. Postman > Import > chọn file này.\n2. Chạy lần lượt từ request 01 (đăng ký sẽ lưu token tự động cho các request sau).\n3. Xem tab 'Test Results' ở mỗi response.\n4. Chạy cả bộ: bấm '...' trên collection > Run.\n\nBiến cấu hình ở tab Variables của collection: baseUrl, password, accessToken, agentId, datasourceId.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "58651226",
		"_collection_link": "https://tranthunga2603-3696205.postman.co/workspace/Thu-Nga-Tr%25E1%25BA%25A7n's-Workspace~f72f0897-72f4-47fb-87fb-581bb68d96c7/collection/58651226-55781156-6471-4de9-9c55-317b45e4cf6f?action=share&source=collection_link&creator=58651226"
	},
	"item": [
		{
			"name": "01. Đăng ký - hợp lệ (lưu token)",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// Tạo email mới mỗi lần chạy để không trùng",
							"pm.collectionVariables.set('email', 'qa_' + Date.now() + '@example.com');"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Tạo tài khoản thành công (200/201)', function () {",
							"  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
							"});",
							"",
							"var json = {};",
							"try { json = pm.response.json(); } catch(e) {}",
							"",
							"pm.test('Response có access_token', function () {",
							"  pm.expect(json).to.have.property('access_token');",
							"});",
							"",
							"pm.test('Response KHÔNG lộ mật khẩu / hash', function () {",
							"  var body = pm.response.text().toLowerCase();",
							"  pm.expect(body).to.not.include('\"password\"');",
							"  pm.expect(body).to.not.include('hash');",
							"});",
							"",
							"// Lưu token cho các request sau",
							"if (json.access_token) { pm.collectionVariables.set('accessToken', json.access_token); }"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"QA Test\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/register",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"register"
					]
				}
			},
			"response": []
		},
		{
			"name": "02. Đăng ký - thiếu đồng ý điều khoản (REGRESSION bug E3)",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.collectionVariables.set('email', 'qa_noterms_' + Date.now() + '@example.com');"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// Kỳ vọng ĐÚNG: server phải từ chối khi body không có trường đồng ý điều khoản.",
							"// Hiện tại makaseba vẫn trả 201 -> test này FAIL = bug BUG-003 còn tồn tại.",
							"// Khi dev thêm kiểm tra điều khoản ở server, test sẽ chuyển sang PASS.",
							"pm.test('Server phải từ chối đăng ký thiếu đồng ý điều khoản (400/422)', function () {",
							"  pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"QA NoTerms\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/register",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"register"
					]
				}
			},
			"response": []
		},
